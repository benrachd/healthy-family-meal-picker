{
  "name": "healthy-family-meal-picker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-pwa-icons.mjs",
    "build": "tsc -b && vite build",
    "build:ghpages": "tsc -b && vite build && node scripts/postbuild-ghpages.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "preview:ghpages": "npm run build:ghpages && vite preview --base /healthy-family-meal-picker/",
    "images:download": "node scripts/download-images.mjs",
    "verify": "npm run build && node scripts/verify-mvp.mjs",
    "verify:ghpages": "npm run build:ghpages && node scripts/verify-ghpages.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
